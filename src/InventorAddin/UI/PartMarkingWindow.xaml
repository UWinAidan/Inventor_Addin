<Window x:Class="InventorAddin.UI.PartMarkingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:InventorAddin.UI.Controls"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <!--
        DataContext is a PartMarkingViewModel (InventorAddin.Core.ViewModels), set in the constructor.
        Layout and bindings only: the look comes from UI/Theme, applied by WindowHost after the window is built,
        so shared styles are referred to with DynamicResource. SizeToContent and ResizeMode are repeated from the
        DialogWindow style so the window still sizes to its content if the shared styles fail to load.

        Spec 05, "Added for M5", item 2 (task 199). The method and the target are dropdowns (their lists are set by the
        constructor; the selection is a value of the view-model's enum). The extra lines are typed one per line. The note
        text is shown as it will be placed. The engrave tick box (task 200) is offered only for a part with a method; the view-model switches it off otherwise.

        Access keys: M method, T target, E extra lines, N engrave, S show as, O OK.
    -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
    </Window.Resources>
    <Grid Style="{DynamicResource DialogContent}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The header icon is put in the window's resources by WindowHost (HeaderIcon), in the window's theme. -->
        <controls:DialogHeader Grid.Row="0"
                               Icon="{DynamicResource HeaderIcon}"
                               Title="Part Marking"
                               Subline="Mark the part number on the drawing" />

        <ScrollViewer Grid.Row="1" Style="{DynamicResource DialogBody}">
            <StackPanel Style="{DynamicResource DialogBodyContent}">
                <controls:FormSection Heading="Marking">
                    <controls:FieldRow Label="_Method" Target="{Binding ElementName=MethodBox}">
                        <ComboBox x:Name="MethodBox"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding Method, Mode=TwoWay}" />
                    </controls:FieldRow>
                    <controls:FieldRow Label="Character height">
                        <TextBlock Style="{DynamicResource ValueText}" Text="{Binding CharacterHeightText, Mode=OneTime}" />
                    </controls:FieldRow>
                    <!-- One extra line per row, for example DO NOT STAMP. AcceptsReturn makes Enter start a new line instead of pressing OK. -->
                    <controls:FieldRow Label="_Extra lines" Target="{Binding ElementName=ExtraLinesBox}">
                        <TextBox x:Name="ExtraLinesBox"
                                 Style="{DynamicResource MultiLineTextBox}"
                                 AcceptsReturn="True"
                                 Text="{Binding ExtraLinesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </controls:FieldRow>
                    <!-- Task 200: also engrave the part number in the part. Offered for a part with a method; hidden for an assembly or method None. -->
                    <controls:FieldRow Target="{Binding ElementName=EngraveBox}"
                                       Visibility="{Binding CanEngraveFeature, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}">
                        <CheckBox x:Name="EngraveBox"
                                  Content="Engrave part _number in the part"
                                  IsChecked="{Binding EngraveFeature, Mode=TwoWay}" />
                    </controls:FieldRow>
                </controls:FormSection>

                <controls:FormSection Heading="On the drawing">
                    <controls:FieldRow Label="_Show as" Target="{Binding ElementName=TargetBox}">
                        <ComboBox x:Name="TargetBox"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding Target, Mode=TwoWay}" />
                    </controls:FieldRow>
                    <controls:FieldRow Label="Zone size"
                                       Visibility="{Binding IsZone, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}">
                        <TextBlock Style="{DynamicResource ValueText}" Text="{Binding ZoneSizeText, Mode=OneTime}" />
                    </controls:FieldRow>
                    <controls:FieldRow Label="Note">
                        <TextBlock Style="{DynamicResource ValueText}" TextWrapping="Wrap" Text="{Binding PreviewText, Mode=OneWay}" />
                    </controls:FieldRow>
                </controls:FormSection>
            </StackPanel>
        </ScrollViewer>

        <controls:DialogFooter Grid.Row="2" Status="{Binding ProblemText, Mode=OneWay}" IsError="True">
            <Button Style="{DynamicResource PrimaryButton}"
                    Content="_OK"
                    IsDefault="True"
                    IsEnabled="{Binding CanApply, Mode=OneWay}"
                    Click="OnOk" />
            <Button Content="Cancel" IsCancel="True" />
        </controls:DialogFooter>
    </Grid>
</Window>
