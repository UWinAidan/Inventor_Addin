<Window x:Class="InventorAddin.UI.MaterialFinishWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:InventorAddin.UI.Controls"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <!--
        DataContext is a MaterialFinishViewModel (InventorAddin.Core.ViewModels), set in the constructor.
        Layout and bindings only: the look comes from UI/Theme, applied by WindowHost after the window is built,
        so shared styles are referred to with DynamicResource. SizeToContent and ResizeMode are repeated from the
        DialogWindow style so the window still sizes to its content if the shared styles fail to load.

        Spec 03, "Target window: Select Material and Finish" (task 075). Header: the part, or the number of selected
        parts, with the current material and finish (code) under it. Filter: Category, Preferred only, Show paints.
        Two lists side by side, each with its search box above it: Materials (a star marks a preferred material; clicking
        it, or Space on the entry, saves straight away) and Finishes (None and the finishes that suit the selected
        material). Under them, the selection, always shown: a filter, a search or a Ctrl+click can leave a list showing
        no selection while it is kept. Footer: the status line (its tooltip lists every note), Apply, OK, Cancel.

        The list boxes bind to MaterialListSelection and FinishListSelection, never to SelectedMaterial and
        SelectedFinish, so a selection a filter hides is kept (task 072). IsSynchronizedWithCurrentItem is not set.

        Keyboard: Enter in a search box moves to its list (OK is the default button everywhere else); double-click a
        material to go to the Finishes list; double-click a finish for OK.

        Access keys: C category, P preferred only, S show paints, M find material, F find finish, A apply.
    -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />

        <!--
            The selection as text, or a placeholder when no material is selected (the view-model gives ""). An inline
            Style on a TextBlock would replace the shared one, so the shared style is chosen by swapping the template,
            as in Part Properties. Not a focus or Tab stop.
        -->
        <Style x:Key="SelectionOrPlaceholder" TargetType="{x:Type ContentControl}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Style="{DynamicResource ValueText}" Text="{Binding Mode=OneWay}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Content" Value="">
                    <Setter Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <TextBlock Style="{DynamicResource PlaceholderText}" Text="No material selected" />
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Style="{DynamicResource DialogContent}">
        <!-- Header, body, footer. The body row is star-sized, so it scrolls when the window is capped at the screen's height. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The header icon is put in the window's resources by WindowHost (HeaderIcon), in the window's theme. -->
        <controls:DialogHeader Grid.Row="0"
                               Icon="{DynamicResource HeaderIcon}"
                               Title="{Binding HeaderTitle, Mode=OneWay}"
                               Subline="{Binding HeaderSubline, Mode=OneWay}" />

        <ScrollViewer Grid.Row="1" Style="{DynamicResource DialogBody}">
            <StackPanel>
                <controls:FormSection Heading="Filter">
                    <controls:FieldRow Label="_Category" Target="{Binding ElementName=CategoryBox}">
                        <ComboBox x:Name="CategoryBox"
                                  IsEditable="False"
                                  ItemsSource="{Binding Categories, Mode=OneTime}"
                                  SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" />
                    </controls:FieldRow>
                    <controls:FieldRow>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Style="{DynamicResource InlineCheckBox}"
                                      Content="_Preferred only"
                                      IsChecked="{Binding PreferredOnly, Mode=TwoWay}" />
                            <CheckBox Style="{DynamicResource InlineCheckBox}"
                                      Content="_Show paints"
                                      IsChecked="{Binding ShowPaints, Mode=TwoWay}" />
                        </StackPanel>
                    </controls:FieldRow>
                </controls:FormSection>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Style="{DynamicResource LeftColumn}">
                        <controls:FormSection Heading="Materials">
                            <controls:FieldRow Label="Find _material" Target="{Binding ElementName=MaterialSearchBox}">
                                <TextBox x:Name="MaterialSearchBox"
                                         PreviewKeyDown="OnMaterialSearchKeyDown"
                                         Text="{Binding MaterialSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </controls:FieldRow>
                            <ListBox x:Name="MaterialsList"
                                     Style="{DynamicResource PickList}"
                                     AutomationProperties.Name="Materials"
                                     ItemsSource="{Binding Materials, Mode=OneWay}"
                                     SelectedItem="{Binding MaterialListSelection, Mode=TwoWay}"
                                     MouseDoubleClick="OnMaterialDoubleClick"
                                     PreviewKeyDown="OnMaterialsKeyDown">
                                <ListBox.ItemTemplate>
                                    <!-- DataContext is a MaterialRow. -->
                                    <DataTemplate>
                                        <DockPanel>
                                            <!--
                                                Not a Tab stop, so Tab leaves the list in one step; Space on the entry toggles
                                                the star from the keyboard (code-behind). Tag draws a preferred star strong.
                                            -->
                                            <Button DockPanel.Dock="Left"
                                                    Style="{DynamicResource StarButton}"
                                                    Focusable="False"
                                                    Command="{Binding ToggleStarCommand}"
                                                    Tag="{Binding IsPreferred, Mode=OneWay}"
                                                    AutomationProperties.Name="Preferred material"
                                                    ToolTip="Preferred material. Click, or press Space on the entry, to add or remove the star.">
                                                <TextBlock x:Name="Star" Text="&#x2606;" />
                                            </Button>
                                            <TextBlock Style="{DynamicResource ValueText}"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       Text="{Binding Name, Mode=OneTime}"
                                                       ToolTip="{Binding Name, Mode=OneTime}" />
                                        </DockPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsPreferred, Mode=OneWay}" Value="True">
                                                <Setter TargetName="Star" Property="Text" Value="&#x2605;" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </controls:FormSection>
                    </StackPanel>

                    <controls:FormSection Grid.Column="1" Heading="Finishes">
                        <controls:FieldRow Label="Find _finish" Target="{Binding ElementName=FinishSearchBox}">
                            <TextBox x:Name="FinishSearchBox"
                                     PreviewKeyDown="OnFinishSearchKeyDown"
                                     Text="{Binding FinishSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </controls:FieldRow>
                        <!-- Empty until a material is selected; then None first. -->
                        <ListBox x:Name="FinishesList"
                                 Style="{DynamicResource PickList}"
                                 AutomationProperties.Name="Finishes"
                                 ItemsSource="{Binding Finishes, Mode=OneWay}"
                                 SelectedItem="{Binding FinishListSelection, Mode=TwoWay}"
                                 MouseDoubleClick="OnFinishDoubleClick">
                            <ListBox.ItemTemplate>
                                <!-- DataContext is a FinishRow. -->
                                <DataTemplate>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right"
                                                   Style="{DynamicResource SideIdentifierText}"
                                                   Text="{Binding Code, Mode=OneTime}" />
                                        <TextBlock Style="{DynamicResource ValueText}"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding Name, Mode=OneTime}"
                                                   ToolTip="{Binding Name, Mode=OneTime}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </controls:FormSection>
                </Grid>

                <controls:FormSection>
                    <controls:FieldRow Label="Selected">
                        <StackPanel>
                            <ContentControl Style="{StaticResource SelectionOrPlaceholder}"
                                            Content="{Binding SelectionText, Mode=OneWay}" />
                            <TextBlock Style="{DynamicResource MutedText}"
                                       Text="Hidden from a list by a filter or search; Apply still uses it."
                                       Visibility="{Binding SelectionIsHidden, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}" />
                        </StackPanel>
                    </controls:FieldRow>
                </controls:FormSection>
            </StackPanel>
        </ScrollViewer>

        <!--
            Status line and buttons in one row: the result of the last Apply or star, or the finish list's problems at
            open; its tooltip lists every note (skipped components, appearances not found, finish rows left out).
        -->
        <controls:DialogFooter Grid.Row="2"
                               Status="{Binding StatusText, Mode=OneWay}"
                               IsError="{Binding StatusIsError, Mode=OneWay}"
                               StatusToolTip="{Binding StatusDetails, Mode=OneWay}">
            <Button Content="_Apply" Command="{Binding ApplyCommand}" />
            <Button Style="{DynamicResource PrimaryButton}" Content="OK" IsDefault="True" Command="{Binding OkCommand}" />
            <!-- IsCancel closes a dialog shown with ShowDialog; nothing more is applied. -->
            <Button Content="Cancel" IsCancel="True" />
        </controls:DialogFooter>
    </Grid>
</Window>
