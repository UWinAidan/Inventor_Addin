<Window x:Class="InventorAddin.UI.RenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:InventorAddin.UI.Controls"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <!--
        DataContext is a RenameViewModel (InventorAddin.Core.ViewModels), set in the constructor.
        Layout and bindings only: the look comes from UI/Theme, applied by WindowHost after the window is built,
        so shared styles are referred to with DynamicResource. SizeToContent and ResizeMode are repeated from the
        DialogWindow style so the window still sizes to its content if the shared styles fail to load.

        Spec 02, "Commands: Rename" (task 047), opened from the Rename button in Part Properties. Three states:
        editing the new name (Rename and Cancel), running (the footer shows the file being checked; nothing can be
        pressed), and done (the result list, and Close). The footer shows the first problem with the name, the progress,
        or the summary of the result, in the error style when something went wrong.

        Access keys: N new name, R rename.
    -->
    <Window.Resources>
        <!-- Collapses the note while not editing, the result list until done, and the Rename button once done. -->
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
    </Window.Resources>

    <StackPanel Style="{DynamicResource DialogContent}">
        <!-- The header icon is put in the window's resources by WindowHost (HeaderIcon), in the window's theme. -->
        <controls:DialogHeader Icon="{DynamicResource HeaderIcon}"
                               Title="{Binding HeaderTitle, Mode=OneTime}"
                               Subline="{Binding HeaderSubline, Mode=OneTime}" />

        <controls:FormSection Heading="Name">
            <controls:FieldRow Label="Current name">
                <TextBlock Style="{DynamicResource ValueText}" Text="{Binding CurrentName, Mode=OneTime}" />
            </controls:FieldRow>
            <controls:FieldRow Label="_New name" Target="{Binding ElementName=NewNameBox}">
                <TextBox x:Name="NewNameBox"
                         IsEnabled="{Binding IsEditing, Mode=OneWay}"
                         Text="{Binding NewName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </controls:FieldRow>
            <!-- The new file name: the number is kept when the old file name has one. Empty while the name is not valid. -->
            <controls:FieldRow Label="File name">
                <TextBlock Style="{DynamicResource IdentifierText}" Text="{Binding NewFileNamePreview, Mode=OneWay}" />
            </controls:FieldRow>
            <TextBlock Style="{DynamicResource MutedText}"
                       Text="Every assembly, drawing and presentation in the CAD folders that uses this file is updated and saved. Rename cannot be undone with Undo."
                       Visibility="{Binding IsEditing, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}" />
        </controls:FormSection>

        <!-- The result list: one line per file updated or not (with the reason), then the notes. Read-only, scrolls with the wheel. -->
        <controls:FormSection Heading="Result"
                              Visibility="{Binding IsDone, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}">
            <controls:FieldRow Label="Files">
                <TextBox Style="{DynamicResource MultiLineTextBox}"
                         IsReadOnly="True"
                         Text="{Binding ResultText, Mode=OneWay}" />
            </controls:FieldRow>
        </controls:FormSection>

        <controls:DialogFooter Status="{Binding StatusText, Mode=OneWay}" IsError="{Binding HasError, Mode=OneWay}">
            <Button Style="{DynamicResource PrimaryButton}"
                    Content="_Rename"
                    IsDefault="{Binding IsEditing, Mode=OneWay}"
                    Command="{Binding RenameCommand}"
                    Visibility="{Binding IsEditing, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}" />
            <!-- Cancel before the rename, Close after it; IsCancel closes a dialog shown with ShowDialog. Disabled while running. -->
            <Button Content="{Binding CloseText, Mode=OneWay}"
                    IsCancel="True"
                    IsDefault="{Binding IsDone, Mode=OneWay}"
                    IsEnabled="{Binding CanClose, Mode=OneWay}" />
        </controls:DialogFooter>
    </StackPanel>
</Window>
