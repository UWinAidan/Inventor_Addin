<Window x:Class="InventorAddin.UI.PartPropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <!-- DataContext is a PartPropertiesViewModel (InventorAddin.Core.ViewModels), set in the constructor. -->
    <Window.Resources>
        <!-- Read-only fields: grey, but the text can still be selected and copied. -->
        <Style x:Key="ReadOnlyField" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="EditableField" TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="Label">
            <Setter Property="Padding" Value="0,2,12,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="16" Width="420">
        <TextBlock Margin="0,0,0,12"
                   FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis"
                   Text="{Binding FileName, Mode=OneWay}"
                   ToolTip="{Binding FileName, Mode=OneWay}" />

        <!-- Fields in the order of spec 07's table. -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Content="Part number" />
            <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource ReadOnlyField}"
                     Text="{Binding PartNumber, Mode=OneWay}" />

            <Label Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Content="Part name" />
            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource ReadOnlyField}"
                     Text="{Binding PartName, Mode=OneWay}" />

            <Label Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}"
                   Content="Part _type" Target="{Binding ElementName=PartTypeBox}" />
            <!--
                Not editable. The closed box shows the code; each dropdown entry shows "code: full name".
                The template tells the two apart by whether it sits inside a ComboBoxItem (only dropdown entries do).
            -->
            <ComboBox x:Name="PartTypeBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,6"
                      IsEditable="False"
                      IsEnabled="{Binding IsEditable, Mode=OneWay}"
                      ItemsSource="{Binding PartTypeOptions, Mode=OneWay}"
                      SelectedValuePath="Code"
                      SelectedValue="{Binding PartType, Mode=TwoWay}">
                <ComboBox.Style>
                    <Style TargetType="ComboBox">
                        <Setter Property="ToolTip" Value="{Binding PartTypeFullName, Mode=OneWay}" />
                        <Style.Triggers>
                            <!-- No tooltip for a blank code, rather than an empty one. -->
                            <DataTrigger Binding="{Binding PartTypeFullName, Mode=OneWay}" Value="">
                                <Setter Property="ToolTip" Value="{x:Null}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ComboBox.Style>
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock x:Name="OptionText" MinHeight="16" Text="{Binding DisplayText, Mode=OneWay}" />
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" Value="{x:Null}">
                                <Setter TargetName="OptionText" Property="Text" Value="{Binding Code, Mode=OneWay}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <Label Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabel}"
                   Content="_Designer" Target="{Binding ElementName=DesignerBox}" />
            <TextBox x:Name="DesignerBox" Grid.Row="3" Grid.Column="1" Style="{StaticResource EditableField}"
                     IsEnabled="{Binding IsEditable, Mode=OneWay}"
                     Text="{Binding Designer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <Label Grid.Row="4" Grid.Column="0" Style="{StaticResource FieldLabel}"
                   Content="D_etailer" Target="{Binding ElementName=DetailerBox}" />
            <TextBox x:Name="DetailerBox" Grid.Row="4" Grid.Column="1" Style="{StaticResource EditableField}"
                     IsEnabled="{Binding IsEditable, Mode=OneWay}"
                     Text="{Binding Detailer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <Label Grid.Row="5" Grid.Column="0" Style="{StaticResource FieldLabel}"
                   Content="_Cost" Target="{Binding ElementName=CostBox}" />
            <TextBox x:Name="CostBox" Grid.Row="5" Grid.Column="1" Style="{StaticResource EditableField}"
                     IsEnabled="{Binding IsEditable, Mode=OneWay}"
                     Text="{Binding CostText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <Label Grid.Row="6" Grid.Column="0" Style="{StaticResource FieldLabel}" Content="Material" />
            <TextBox Grid.Row="6" Grid.Column="1" Style="{StaticResource ReadOnlyField}"
                     Text="{Binding Material, Mode=OneWay}" />

            <Label Grid.Row="7" Grid.Column="0" Style="{StaticResource FieldLabel}" Content="Finish" />
            <TextBox Grid.Row="7" Grid.Column="1" Style="{StaticResource ReadOnlyField}"
                     Text="{Binding Finish, Mode=OneWay}" />

            <Label Grid.Row="8" Grid.Column="0" Style="{StaticResource FieldLabel}" Content="Weight" />
            <TextBox Grid.Row="8" Grid.Column="1" Style="{StaticResource ReadOnlyField}"
                     Text="{Binding Weight, Mode=OneWay}" />
        </Grid>

        <!-- Status line: red for a validation or write error, as in the Settings window. -->
        <TextBlock Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Text="{Binding StatusText, Mode=OneWay}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasError}" Value="True">
                            <Setter Property="Foreground" Value="Firebrick" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <StackPanel Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="_Apply" MinWidth="80" Command="{Binding ApplyCommand}" />
            <Button Content="OK" MinWidth="80" Margin="8,0,0,0" IsDefault="True" Command="{Binding OkCommand}" />
            <!-- IsCancel closes a dialog shown with ShowDialog; nothing is written. -->
            <Button Content="Cancel" MinWidth="80" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
