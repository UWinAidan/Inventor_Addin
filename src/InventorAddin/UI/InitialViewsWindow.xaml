<Window x:Class="InventorAddin.UI.InitialViewsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:InventorAddin.UI.Controls"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <!--
        DataContext is an InitialViewsViewModel (InventorAddin.Core.ViewModels), set in the constructor.
        Layout and bindings only: the look comes from UI/Theme, applied by WindowHost after the window is built,
        so shared styles are referred to with DynamicResource. SizeToContent and ResizeMode are repeated from the
        DialogWindow style so the window still sizes to its content if the shared styles fail to load.

        Spec 05, "Decided for M5: Place Initial Views" (task 192). Shown by Create Print before the print is made
        and by Place Initial Views. The views the model offers are tick boxes; the scale is "Suggested (1:2)" or a
        standard scale. The footer shows the plan's warnings. OK is disabled when no view would be placed.

        Task 232: when the window is made by Create Print it also offers the print's units (Metric | Imperial, the AWB
        template) and the sheet size, and offers the next larger sheet when the views do not fit; Place Initial Views works on
        the sheet it is given, so that section is hidden there.

        Access keys: U units, Z sheet size, S scale, O OK.
    -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
    </Window.Resources>
    <Grid Style="{DynamicResource DialogContent}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The header icon is put in the window's resources by WindowHost (HeaderIcon), in the window's theme. -->
        <controls:DialogHeader Grid.Row="0"
                               Icon="{DynamicResource HeaderIcon}"
                               Title="Initial Views"
                               Subline="{Binding SheetSizeText, Mode=OneWay}" />

        <ScrollViewer Grid.Row="1" Style="{DynamicResource DialogBody}">
            <StackPanel Style="{DynamicResource DialogBodyContent}">
                <controls:FormSection Heading="Views">
                    <ItemsControl Focusable="False" ItemsSource="{Binding Views, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <!-- DataContext is an InitialViewChoice. -->
                            <DataTemplate>
                                <CheckBox Content="{Binding Label, Mode=OneTime}"
                                          IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </controls:FormSection>

                <controls:FormSection Heading="Sheet"
                                      Visibility="{Binding CanChooseSheet, Mode=OneTime, Converter={StaticResource VisibleWhenTrue}}">
                    <controls:FieldRow Label="_Units" Target="{Binding ElementName=UnitsBox}">
                        <ComboBox x:Name="UnitsBox"
                                  ItemsSource="{Binding UnitsOptions, Mode=OneTime}"
                                  DisplayMemberPath="Label"
                                  SelectedItem="{Binding SelectedUnits, Mode=TwoWay}" />
                    </controls:FieldRow>
                    <controls:FieldRow Label="Sheet si_ze" Target="{Binding ElementName=SheetBox}">
                        <ComboBox x:Name="SheetBox"
                                  ItemsSource="{Binding SheetOptions, Mode=OneWay}"
                                  DisplayMemberPath="Label"
                                  SelectedItem="{Binding SelectedSheet, Mode=TwoWay}" />
                    </controls:FieldRow>
                    <controls:FieldRow Label="Fits"
                                       Visibility="{Binding HasNextSheetOffer, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource ValueText}" TextWrapping="Wrap" Text="{Binding NextSheetOffer, Mode=OneWay}" />
                            <Button Content="{Binding NextSheetButtonText, Mode=OneWay}" Command="{Binding UseNextSheetCommand}" />
                        </StackPanel>
                    </controls:FieldRow>
                </controls:FormSection>

                <controls:FormSection Heading="Scale">
                    <controls:FieldRow Label="_Scale" Target="{Binding ElementName=ScaleBox}">
                        <ComboBox x:Name="ScaleBox"
                                  ItemsSource="{Binding ScaleOptions, Mode=OneTime}"
                                  DisplayMemberPath="Label"
                                  SelectedItem="{Binding SelectedScale, Mode=TwoWay}" />
                    </controls:FieldRow>
                    <controls:FieldRow Label="Used">
                        <TextBlock Style="{DynamicResource ValueText}" Text="{Binding ScaleText, Mode=OneWay}" />
                    </controls:FieldRow>
                </controls:FormSection>
            </StackPanel>
        </ScrollViewer>

        <controls:DialogFooter Grid.Row="2" Status="{Binding Warning, Mode=OneWay}" IsError="{Binding HasWarning, Mode=OneWay}">
            <Button Style="{DynamicResource PrimaryButton}"
                    Content="_OK"
                    IsDefault="True"
                    Command="{Binding OkCommand}" />
            <!-- IsCancel closes a dialog shown with ShowDialog (also on Esc); the view-model's Result stays null. -->
            <Button Content="Cancel" IsCancel="True" />
        </controls:DialogFooter>
    </Grid>
</Window>
