<Window x:Class="InventorAddin.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <!-- DataContext is a SettingsViewModel (InventorAddin.Core.ViewModels), set in the constructor. -->
    <StackPanel Margin="16" MinWidth="320" MaxWidth="480">
        <CheckBox Content="Show developer tools"
                  IsChecked="{Binding ShowDeveloperTools, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Margin="0,4,0,0"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                   Text="{Binding RestartNotice}" />

        <Label Margin="0,12,0,0"
               Padding="0,0,0,4"
               Content="_Default designer"
               Target="{Binding ElementName=DefaultDesignerBox}" />
        <TextBox x:Name="DefaultDesignerBox"
                 Text="{Binding DefaultDesigner, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Margin="0,4,0,0"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                   Text="Filled in as Designer in Part Properties when a file has none." />

        <TextBlock Margin="0,12,0,0"
                   TextWrapping="Wrap"
                   Foreground="Firebrick"
                   Text="{Binding ErrorText}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasError}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <StackPanel Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save" MinWidth="80" IsDefault="True" Command="{Binding SaveCommand}" />
            <!-- IsCancel closes a dialog shown with ShowDialog; nothing is saved. -->
            <Button Content="Cancel" MinWidth="80" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
