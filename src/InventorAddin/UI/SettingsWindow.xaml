<Window x:Class="InventorAddin.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:InventorAddin.UI.Controls"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <!--
        DataContext is a SettingsViewModel (InventorAddin.Core.ViewModels), set in the constructor.
        Layout and bindings only: the look comes from UI/Theme, applied by WindowHost after the window is built,
        so shared styles are referred to with DynamicResource. SizeToContent and ResizeMode are repeated from the
        DialogWindow style so the window still sizes to its content if the shared styles fail to load.

        The help lines under the text boxes and the note under the checkbox are rows of their own with no label, so
        they line up with the value column and the row spacing comes from FieldRow. Putting a note in the same row
        as its control would centre the row's label on the pair instead of on the control. Each Browse button sits
        beside its folder box in the shared SideButton style (task 049; task 037 had it on a row of its own): the
        button is docked right and the box fills the rest.

        Labels stay short to fit the 100-wide label column; the help line under each box explains it. The other CAD
        folders row is labelled "Other folders" for that reason.

        Access keys: D default designer, N other names, U new file units, R register folder, B browse (register),
        W work folder, E browse (work folder), O other folders, M material library, F finish list, S show developer
        tools. The Browse buttons beside the material library and finish list have no access key: every letter of
        "Browse" is taken.
    -->
    <StackPanel Style="{DynamicResource DialogContent}">
        <!-- The header icon is put in the window's resources by WindowHost (HeaderIcon), in the window's theme. -->
        <controls:DialogHeader Icon="{DynamicResource HeaderIcon}"
                               Title="{Binding HeaderTitle, Mode=OneTime}"
                               Subline="{Binding HeaderSubline, Mode=OneTime}" />

        <controls:FormSection Heading="General">
            <controls:FieldRow Label="_Default designer" Target="{Binding ElementName=DefaultDesignerBox}">
                <TextBox x:Name="DefaultDesignerBox"
                         Text="{Binding DefaultDesigner, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </controls:FieldRow>
            <controls:FieldRow>
                <TextBlock Style="{DynamicResource MutedText}" Text="{Binding DefaultDesignerHelp, Mode=OneTime}" />
            </controls:FieldRow>
            <controls:FieldRow Label="Other _names" Target="{Binding ElementName=OtherNamesBox}">
                <TextBox x:Name="OtherNamesBox"
                         Text="{Binding OtherNamesForMe, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </controls:FieldRow>
            <controls:FieldRow>
                <TextBlock Style="{DynamicResource MutedText}" Text="{Binding OtherNamesHelp, Mode=OneTime}" />
            </controls:FieldRow>
            <controls:FieldRow Label="New file _units" Target="{Binding ElementName=DefaultUnitsBox}">
                <ComboBox x:Name="DefaultUnitsBox"
                          IsEditable="False"
                          ItemsSource="{Binding UnitsOptions, Mode=OneTime}"
                          DisplayMemberPath="DisplayText"
                          SelectedValuePath="Units"
                          SelectedValue="{Binding DefaultUnits, Mode=TwoWay}" />
            </controls:FieldRow>
        </controls:FormSection>

        <controls:FormSection Heading="Part numbers">
            <controls:FieldRow Label="_Register folder" Target="{Binding ElementName=RegisterFolderBox}">
                <DockPanel>
                    <!-- Opens a folder picker and puts the chosen folder in the box beside it (code-behind). -->
                    <Button DockPanel.Dock="Right"
                            Style="{DynamicResource SideButton}"
                            Content="_Browse..."
                            Click="OnBrowseRegisterFolder" />
                    <TextBox x:Name="RegisterFolderBox"
                             Text="{Binding RegisterFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
            </controls:FieldRow>
            <controls:FieldRow>
                <TextBlock Style="{DynamicResource MutedText}" Text="{Binding RegisterFolderHelp, Mode=OneTime}" />
            </controls:FieldRow>
        </controls:FormSection>

        <controls:FormSection Heading="Folders">
            <controls:FieldRow Label="_Work folder" Target="{Binding ElementName=WorkFolderBox}">
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Style="{DynamicResource SideButton}"
                            Content="Brows_e..."
                            Click="OnBrowseWorkFolder" />
                    <TextBox x:Name="WorkFolderBox"
                             Text="{Binding WorkFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
            </controls:FieldRow>
            <controls:FieldRow>
                <TextBlock Style="{DynamicResource MutedText}" Text="{Binding WorkFolderHelp, Mode=OneTime}" />
            </controls:FieldRow>
            <!-- One folder per line. AcceptsReturn makes Enter start a new line here instead of pressing Save. -->
            <controls:FieldRow Label="_Other folders" Target="{Binding ElementName=OtherCadFoldersBox}">
                <TextBox x:Name="OtherCadFoldersBox"
                         Style="{DynamicResource MultiLineTextBox}"
                         AcceptsReturn="True"
                         Text="{Binding OtherCadFolders, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </controls:FieldRow>
            <controls:FieldRow>
                <TextBlock Style="{DynamicResource MutedText}" Text="{Binding OtherCadFoldersHelp, Mode=OneTime}" />
            </controls:FieldRow>
        </controls:FormSection>

        <controls:FormSection Heading="Material and finish">
            <controls:FieldRow Label="_Material library" Target="{Binding ElementName=MaterialLibraryBox}">
                <DockPanel>
                    <!-- Opens a file picker for an .adsklib and puts the chosen file in the box beside it (code-behind). -->
                    <Button DockPanel.Dock="Right"
                            Style="{DynamicResource SideButton}"
                            Content="Browse..."
                            Click="OnBrowseMaterialLibrary" />
                    <TextBox x:Name="MaterialLibraryBox"
                             Text="{Binding MaterialLibraryPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
            </controls:FieldRow>
            <controls:FieldRow>
                <TextBlock Style="{DynamicResource MutedText}" Text="{Binding MaterialLibraryHelp, Mode=OneTime}" />
            </controls:FieldRow>
            <controls:FieldRow Label="_Finish list" Target="{Binding ElementName=FinishListBox}">
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Style="{DynamicResource SideButton}"
                            Content="Browse..."
                            Click="OnBrowseFinishList" />
                    <TextBox x:Name="FinishListBox"
                             Text="{Binding FinishListPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
            </controls:FieldRow>
            <controls:FieldRow>
                <TextBlock Style="{DynamicResource MutedText}" Text="{Binding FinishListHelp, Mode=OneTime}" />
            </controls:FieldRow>
        </controls:FormSection>

        <controls:FormSection Heading="Developer">
            <controls:FieldRow>
                <CheckBox Content="_Show developer tools"
                          IsChecked="{Binding ShowDeveloperTools, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </controls:FieldRow>
            <controls:FieldRow>
                <TextBlock Style="{DynamicResource MutedText}" Text="{Binding RestartNotice, Mode=OneTime}" />
            </controls:FieldRow>
        </controls:FormSection>

        <!-- ErrorText is null when there is no error, which collapses the status line. -->
        <controls:DialogFooter Status="{Binding ErrorText}" IsError="{Binding HasError}">
            <Button Style="{DynamicResource PrimaryButton}" Content="Save" IsDefault="True" Command="{Binding SaveCommand}" />
            <!-- IsCancel closes a dialog shown with ShowDialog; nothing is saved. -->
            <Button Content="Cancel" IsCancel="True" />
        </controls:DialogFooter>
    </StackPanel>
</Window>
