<Window x:Class="InventorAddin.UI.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:InventorAddin.UI.Controls"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <!--
        DataContext is an AboutViewModel (InventorAddin.Core.ViewModels), set in the constructor.
        Layout and bindings only: the look comes from UI/Theme, applied by WindowHost after the window is built,
        so shared styles are referred to with DynamicResource. SizeToContent and ResizeMode are repeated from the
        DialogWindow style so the window still sizes to its content if the shared styles fail to load.
    -->
    <StackPanel Style="{DynamicResource DialogContent}">
        <controls:DialogHeader Title="{Binding Title, Mode=OneTime}"
                               Subline="{Binding HeaderSubline, Mode=OneTime}" />

        <controls:FormSection>
            <controls:FieldRow Label="Built">
                <TextBlock Style="{DynamicResource ValueText}" Text="{Binding BuildDate, Mode=OneTime}" />
            </controls:FieldRow>
            <controls:FieldRow Label="Inventor version">
                <TextBlock Style="{DynamicResource ValueText}" Text="{Binding InventorRelease, Mode=OneTime}" />
            </controls:FieldRow>
            <controls:FieldRow Label="Log folder">
                <!-- Selectable so the path can be copied. -->
                <TextBox Style="{DynamicResource SelectableIdentifierText}" Text="{Binding LogFolder, Mode=OneTime}" />
            </controls:FieldRow>
        </controls:FormSection>

        <controls:DialogFooter>
            <!-- IsCancel closes a dialog shown with ShowDialog; IsDefault lets Enter close it too. -->
            <Button Style="{DynamicResource PrimaryButton}" Content="Close" IsDefault="True" IsCancel="True" />
        </controls:DialogFooter>
    </StackPanel>
</Window>
