<!--
    The shared look (spec 08, "The look"). Every size, font and gap a window uses comes from here; every colour
    comes from Colors.Light.xaml or Colors.Dark.xaml through DynamicResource, so this file works with either set.
    WindowHost merges a colour dictionary and then this file into each window's resources after the window is
    built, which is why windows refer to these styles with DynamicResource. Inside this file, BasedOn and
    FocusVisualStyle use StaticResource to keys defined earlier in the same file.
    The input control styles (text box, dropdown, checkbox) are added by task 027.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:InventorAddin.UI.Controls">

    <!-- ===== Window ===== -->

    <!-- Applied by WindowHost with SetResourceReference: an implicit Window style does not reach derived window types. -->
    <Style x:Key="DialogWindow" TargetType="{x:Type Window}">
        <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="SizeToContent" Value="WidthAndHeight" />
        <Setter Property="ResizeMode" Value="NoResize" />
        <Setter Property="ShowInTaskbar" Value="False" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <!-- The window's root panel: the content padding (22 left and right, 18 top and bottom) and the width range. -->
    <Style x:Key="DialogContent" TargetType="{x:Type FrameworkElement}">
        <Setter Property="Margin" Value="22,18,22,18" />
        <Setter Property="MinWidth" Value="360" />
        <Setter Property="MaxWidth" Value="560" />
    </Style>

    <!-- ===== Keyboard focus ===== -->

    <!--
        A 2 px Accent outline drawn just outside the control, with a 1 px gap so it shows on an Accent fill too.
        Used as FocusVisualStyle by the button styles; task 027 uses it for the input controls.
    -->
    <Style x:Key="FocusOutline">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3"
                            BorderThickness="2"
                            CornerRadius="6"
                            BorderBrush="{DynamicResource AccentBrush}"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Text ===== -->

    <Style x:Key="HeaderTitleText" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="HeaderSublineText" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Upper case and letter spacing come from FormSection (WPF's TextBlock has neither). -->
    <Style x:Key="SectionHeadingText" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource SectionHeadingBrush}" />
    </Style>

    <!-- A Label rather than a TextBlock, so it can carry an access key and a Target. -->
    <Style x:Key="LabelText" TargetType="{x:Type Label}">
        <Setter Property="Foreground" Value="{DynamicResource TextLabelBrush}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="ValueText" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="IdentifierText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ValueText}">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="PlaceholderText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ValueText}">
        <Setter Property="Foreground" Value="{DynamicResource TextPlaceholderBrush}" />
    </Style>

    <Style x:Key="MutedText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ValueText}">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>

    <Style x:Key="StatusText" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ErrorStatusText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource StatusText}">
        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    </Style>

    <!--
        Read-only text that can be selected and copied (for example the log folder). A TextBox with no border,
        no fill and no focus outline, out of the Tab order. The template has only the text host, so no hover or
        focus border appears either.
    -->
    <Style x:Key="SelectableText" TargetType="{x:Type TextBox}">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <ScrollViewer x:Name="PART_ContentHost"
                                  Focusable="False"
                                  Background="Transparent"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Hidden" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SelectableIdentifierText" TargetType="{x:Type TextBox}" BasedOn="{StaticResource SelectableText}">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- ===== Buttons ===== -->

    <!--
        Secondary button (Cancel, Close, Apply): the implicit style, so every Button gets it.
        Fill: InputBackground (white in light). The spec asks for transparent in dark, which has no token; see task 026 Follow-ups.
        Hover and pressed lay a thin TextPrimary veil over the fill: it darkens in light and lightens in dark,
        and works on the Accent fill of the primary button too, so no extra colours are needed.
    -->
    <Style TargetType="{x:Type Button}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusOutline}" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Height" Value="30" />
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="Padding" Value="14,0,14,0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid>
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" />
                        <Border x:Name="Veil"
                                Background="{DynamicResource TextPrimaryBrush}"
                                CornerRadius="4"
                                Opacity="0"
                                IsHitTestVisible="False" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Veil" Property="Opacity" Value="0.08" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Veil" Property="Opacity" Value="0.16" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Veil" Property="Opacity" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- Style triggers outrank the setters of a derived style, so this also covers PrimaryButton. -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{DynamicResource DisabledBorderBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Primary button (the default button, usually OK, Save or Close). -->
    <Style x:Key="PrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- ===== Shared pieces (UI/Controls) ===== -->

    <!-- Header band: icon tile, title, subline; 18 above the first section. -->
    <Style TargetType="{x:Type controls:DialogHeader}">
        <Setter Property="Margin" Value="0,0,0,18" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:DialogHeader}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Width="36"
                                Height="36"
                                CornerRadius="6"
                                VerticalAlignment="Center"
                                Background="{DynamicResource IconTileBrush}">
                            <Image Margin="2"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Source="{TemplateBinding Icon}" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Style="{DynamicResource HeaderTitleText}" Text="{TemplateBinding Title}" />
                            <TextBlock x:Name="SublineText"
                                       Style="{DynamicResource HeaderSublineText}"
                                       Text="{TemplateBinding Subline}" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Subline" Value="{x:Null}">
                            <Setter TargetName="SublineText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Subline" Value="">
                            <Setter TargetName="SublineText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Section: heading, 1 px divider, 9 to the first row. Each row ends with its own 9; the section adds 9 more,
        so the gap to the next section or to the footer is 18. With no heading, the heading and divider are not drawn.
    -->
    <Style TargetType="{x:Type controls:FormSection}">
        <Setter Property="Margin" Value="0,0,0,9" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:FormSection}">
                    <StackPanel>
                        <StackPanel x:Name="HeadingPanel" Margin="0,0,0,9">
                            <TextBlock Style="{DynamicResource SectionHeadingText}"
                                       Text="{TemplateBinding DisplayHeading}"
                                       AutomationProperties.Name="{TemplateBinding Heading}" />
                            <Border Height="1" Margin="0,4,0,0" Background="{DynamicResource DividerBrush}" />
                        </StackPanel>
                        <ItemsPresenter />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasHeading" Value="False">
                            <Setter TargetName="HeadingPanel" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Row: label column 100 wide, 12 to the value, 9 below each row. -->
    <Style TargetType="{x:Type controls:FieldRow}">
        <Setter Property="Margin" Value="0,0,0,9" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:FieldRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0"
                               Style="{DynamicResource LabelText}"
                               Content="{TemplateBinding Label}"
                               Target="{TemplateBinding Target}" />
                        <ContentPresenter Grid.Column="1"
                                          Margin="12,0,0,0"
                                          VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Footer: status line on the left (muted, or the error style when IsError; not drawn when empty),
        buttons on the right, 8 apart, in one row. The 8 is on the left of every button, which also keeps
        the status line clear of the first button.
    -->
    <Style TargetType="{x:Type controls:DialogFooter}">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="{x:Type ContentPresenter}">
                    <Setter Property="Margin" Value="8,0,0,0" />
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:DialogFooter}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusLine"
                                   Grid.Column="0"
                                   Style="{DynamicResource StatusText}"
                                   Text="{TemplateBinding Status}" />
                        <TextBlock x:Name="ErrorLine"
                                   Grid.Column="0"
                                   Visibility="Collapsed"
                                   Style="{DynamicResource ErrorStatusText}"
                                   Text="{TemplateBinding Status}" />
                        <ItemsPresenter Grid.Column="1" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Later triggers win: an empty status hides both lines. -->
                        <Trigger Property="IsError" Value="True">
                            <Setter TargetName="StatusLine" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ErrorLine" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Status" Value="{x:Null}">
                            <Setter TargetName="StatusLine" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ErrorLine" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Status" Value="">
                            <Setter TargetName="StatusLine" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ErrorLine" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
