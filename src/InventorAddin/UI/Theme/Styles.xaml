<!--
    The shared look (spec 08, "The look"). Every size, font and gap a window uses comes from here; every colour
    comes from Colors.Light.xaml or Colors.Dark.xaml through DynamicResource, so this file works with either set.
    WindowHost merges a colour dictionary and then this file into each window's resources after the window is
    built, which is why windows refer to these styles with DynamicResource. Inside this file, BasedOn (which cannot
    be dynamic) and the button styles' FocusVisualStyle use StaticResource to keys defined earlier in the same file;
    the input control styles (text box, dropdown, checkbox) refer to their focus outline with DynamicResource.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:controls="clr-namespace:InventorAddin.UI.Controls">

    <!-- ===== Window ===== -->

    <!-- Applied by WindowHost with SetResourceReference: an implicit Window style does not reach derived window types. -->
    <Style x:Key="DialogWindow" TargetType="{x:Type Window}">
        <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="SizeToContent" Value="WidthAndHeight" />
        <Setter Property="ResizeMode" Value="NoResize" />
        <Setter Property="ShowInTaskbar" Value="False" />
        <!--
            No UseLayoutRounding. Seen in Inventor 2026 at 150% display scale: with it on, a row whose bottom gap is an
            odd number (9 is 13.5 pixels) came out one pixel shorter than the 30-high control inside it, and the row
            cut off the bottom border of every text box and dropdown. Pixel snapping keeps the lines sharp instead.
        -->
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- The window's root panel: the content padding (22 left and right, 18 top and bottom) and the width range. -->
    <Style x:Key="DialogContent" TargetType="{x:Type FrameworkElement}">
        <Setter Property="Margin" Value="22,18,22,18" />
        <Setter Property="MinWidth" Value="360" />
        <Setter Property="MaxWidth" Value="560" />
    </Style>

    <!--
        The window's body, between the header and the footer (Aidan, 2026-10-17): a window is never taller than the
        screen's working area (WindowHost caps it), and when the content is taller the body scrolls while the header
        and buttons stay in view. The root panel is a Grid whose body row is star-sized, so it takes what is left.
        No sideways scroll: the content wraps to the window's width.

        Where the scroll bar goes (Aidan, 2026-10-17): in the window's right margin, outside the content column, so the
        content's right edge lines up with the header and footer whether or not the bar shows, and there is a 12 gap
        between the content and the bar. The scroll viewer reaches 4 past the content on the left, top and bottom and
        20 on the right (a 16 column holding the 8-wide bar against its right edge); DialogBodyContent puts the 4 back
        inside, so the content lands exactly where it would without a scroll viewer, and focus outlines (3 outside a
        control) have room inside the clipped viewport. The bar ends 2 short of the window's edge (the margin is 22).
    -->
    <Style x:Key="DialogBody" TargetType="{x:Type ScrollViewer}">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="-4,-4,-20,-4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollViewer}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                        </Grid.ColumnDefinitions>
                        <ScrollContentPresenter Grid.Column="0" CanContentScroll="{TemplateBinding CanContentScroll}" />
                        <ScrollBar x:Name="PART_VerticalScrollBar"
                                   Grid.Column="1"
                                   HorizontalAlignment="Right"
                                   Orientation="Vertical"
                                   Minimum="0"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Value="{TemplateBinding VerticalOffset}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The panel inside DialogBody: 4 in from the scroll viewer's edges, so the content lines up with the header. -->
    <Style x:Key="DialogBodyContent" TargetType="{x:Type FrameworkElement}">
        <Setter Property="Margin" Value="4" />
    </Style>

    <!--
        Scroll bars (Aidan, 2026-10-17): the implicit style, so every scroll bar in a window gets it: the window body,
        the Mass Update list, the pick lists and the dropdown lists. 8 thick, no arrow buttons, a transparent track and a
        rounded thumb in the input border colour that darkens (light) or lightens (dark) to the muted text colour on
        hover and while dragged. Clicking the track pages. Colours come from the theme dictionaries only.
    -->
    <Style x:Key="ScrollBarPageButton" TargetType="{x:Type RepeatButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollBarThumb" TargetType="{x:Type Thumb}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border x:Name="Grip" CornerRadius="4" Background="{DynamicResource InputBorderBrush}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Grip" Property="Background" Value="{DynamicResource TextMutedBrush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Grip" Property="Background" Value="{DynamicResource TextMutedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="8" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Border Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollBarPageButton}" Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollBarThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollBarPageButton}" Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="8" />
                <Setter Property="MinHeight" Value="8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Border Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track" IsDirectionReversed="False" Focusable="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollBarPageButton}" Command="ScrollBar.PageLeftCommand" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollBarThumb}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollBarPageButton}" Command="ScrollBar.PageRightCommand" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        A resizable window (Settings; task 079): it can be resized by dragging its edges, and WindowHost remembers its
        size and position. Like every dialog it has only the close button: WindowHost removes the minimise and maximise
        buttons and keeps it from being maximised (Aidan, 2026-10-17). It opens 620
        wide and as tall as its content, never taller than the screen's working area. The minimum size keeps the
        header, some of the body and the buttons in view.
    -->
    <Style x:Key="ResizableDialogWindow" TargetType="{x:Type Window}" BasedOn="{StaticResource DialogWindow}">
        <Setter Property="ResizeMode" Value="CanResize" />
        <Setter Property="SizeToContent" Value="Height" />
        <Setter Property="Width" Value="620" />
        <Setter Property="MinWidth" Value="460" />
        <Setter Property="MinHeight" Value="320" />
    </Style>

    <!-- The root panel of a resizable window: as DialogContent, but it widens with the window. -->
    <Style x:Key="ResizableDialogContent" TargetType="{x:Type FrameworkElement}" BasedOn="{StaticResource DialogContent}">
        <Setter Property="MaxWidth" Value="Infinity" />
    </Style>

    <!-- ===== Keyboard focus ===== -->

    <!--
        A 2 px Accent outline drawn just outside the control, with a 1 px gap so it shows on an Accent fill too.
        Used as FocusVisualStyle by the buttons, the text box and the dropdown. The checkbox has its own,
        CheckBoxFocusOutline, drawn round the box only.
    -->
    <Style x:Key="FocusOutline">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3"
                            BorderThickness="2"
                            CornerRadius="6"
                            BorderBrush="{DynamicResource AccentBrush}"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Text ===== -->

    <Style x:Key="HeaderTitleText" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="HeaderSublineText" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Upper case and letter spacing come from FormSection (WPF's TextBlock has neither). -->
    <Style x:Key="SectionHeadingText" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource SectionHeadingBrush}" />
    </Style>

    <!-- A Label rather than a TextBlock, so it can carry an access key and a Target. -->
    <Style x:Key="LabelText" TargetType="{x:Type Label}">
        <Setter Property="Foreground" Value="{DynamicResource TextLabelBrush}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="ValueText" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="IdentifierText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ValueText}">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="PlaceholderText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ValueText}">
        <Setter Property="Foreground" Value="{DynamicResource TextPlaceholderBrush}" />
    </Style>

    <Style x:Key="MutedText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ValueText}">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>

    <Style x:Key="StatusText" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ErrorStatusText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource StatusText}">
        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    </Style>

    <!--
        Read-only text that can be selected and copied (for example the log folder). A TextBox with no border,
        no fill and no focus outline, out of the Tab order. The template has only the text host, so no hover or
        focus border appears either.
    -->
    <Style x:Key="SelectableText" TargetType="{x:Type TextBox}">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <ScrollViewer x:Name="PART_ContentHost"
                                  Focusable="False"
                                  Background="Transparent"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Hidden" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SelectableIdentifierText" TargetType="{x:Type TextBox}" BasedOn="{StaticResource SelectableText}">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- ===== Buttons ===== -->

    <!--
        Secondary button (Cancel, Close, Apply): the implicit style, so every Button gets it.
        Fill: InputBackground (white in light). The spec asks for transparent in dark, which has no token; see task 026 Follow-ups.
        Hover and pressed lay a thin TextPrimary veil over the fill: it darkens in light and lightens in dark,
        and works on the Accent fill of the primary button too, so no extra colours are needed.
    -->
    <Style TargetType="{x:Type Button}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusOutline}" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Height" Value="30" />
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="Padding" Value="14,0,14,0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid>
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" />
                        <Border x:Name="Veil"
                                Background="{DynamicResource TextPrimaryBrush}"
                                CornerRadius="4"
                                Opacity="0"
                                IsHitTestVisible="False" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Veil" Property="Opacity" Value="0.08" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Veil" Property="Opacity" Value="0.16" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Veil" Property="Opacity" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- Style triggers outrank the setters of a derived style, so this also covers PrimaryButton. -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{DynamicResource DisabledBorderBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Primary button (the default button, usually OK, Save or Close). -->
    <Style x:Key="PrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!--
        A secondary button beside a value in a field row (Generate part number), the button gap (8) after it.
        Kept to the left so it does not stretch.
    -->
    <Style x:Key="SideButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- ===== Input controls ===== -->

    <!--
        Text box: the implicit style, so every TextBox a window places gets it. A text box sets no binding
        behaviour here (UpdateSourceTrigger and the like stay with the window). SelectableText above is a separate,
        keyed style and does not build on this one.
        Disabled: the border and text dim, the fill stays, so it still reads as a box that cannot be used now
        rather than as plain text.
    -->
    <Style TargetType="{x:Type TextBox}">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusOutline}" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="8,0,8,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                        <!-- No Margin from Padding here: WPF passes a text box's Padding to this ScrollViewer itself, so adding it again doubles the indent. -->
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="BorderBrush" Value="{DynamicResource DisabledBorderBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A short text box (Cost), 120 wide, kept to the left of its row. -->
    <Style x:Key="NarrowTextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Width" Value="120" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!--
        A text box for several lines, one entry per line (Other CAD folders in Settings): four lines tall, text from
        the top, no wrapping so a long entry stays on its own line. MinLines and MaxLines size it from the font, so
        Height goes back to Auto. The template is the shared one, whose scroll bars are hidden: the box scrolls with
        the caret and the mouse wheel. The window sets AcceptsReturn, as text boxes keep their behaviour to the window.
    -->
    <Style x:Key="MultiLineTextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Height" Value="Auto" />
        <Setter Property="MinLines" Value="4" />
        <Setter Property="MaxLines" Value="4" />
        <Setter Property="Padding" Value="8,5,8,5" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!--
        Dropdown: the implicit style, with a full template so no system colour shows in either theme.
        The structure follows WPF's default: a ToggleButton over the whole box opens the list, a ContentPresenter
        shows the selection (through the window's ItemTemplate, which this style leaves alone), and a Popup holds the
        items in a ScrollViewer. The list is at least as wide as the box and grows to fit its entries.
        Only non-editable dropdowns are styled: this template has no PART_EditableTextBox, so an editable ComboBox
        would show its selection but could not be typed into. Add an editable template if a window ever needs one.
        Hover lays the same thin TextPrimary veil as the buttons over the box.
    -->
    <Style TargetType="{x:Type ComboBox}">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusOutline}" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Height" Value="30" />
        <!-- The right padding leaves room for the arrow. -->
        <Setter Property="Padding" Value="8,0,28,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid x:Name="TemplateRoot" SnapsToDevicePixels="True">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" />
                        <Border x:Name="Veil"
                                Background="{DynamicResource TextPrimaryBrush}"
                                CornerRadius="4"
                                Opacity="0"
                                IsHitTestVisible="False" />
                        <ContentPresenter x:Name="SelectionBox"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        <!-- Covers the whole box so a click anywhere opens the list; draws only the arrow. -->
                        <ToggleButton Focusable="False"
                                      ClickMode="Press"
                                      Foreground="{TemplateBinding Foreground}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Border Background="Transparent">
                                        <Path Margin="0,0,11,0"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Data="M 0,0 L 4,4 L 8,0"
                                              Stroke="{TemplateBinding Foreground}"
                                              StrokeThickness="1.5"
                                              SnapsToDevicePixels="False" />
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Placement="Bottom"
                               Focusable="False"
                               PopupAnimation="{DynamicResource {x:Static SystemParameters.ComboBoxPopupAnimationKey}}"
                               IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border Margin="0,2,0,0"
                                    Padding="2"
                                    MinWidth="{Binding ActualWidth, ElementName=TemplateRoot}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{DynamicResource InputBackgroundBrush}"
                                    BorderBrush="{DynamicResource InputBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer Focusable="False"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"
                                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Veil" Property="Opacity" Value="0.06" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Veil" Property="Opacity" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- The same disabled look as the text box: border and text dim, the fill stays. -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="BorderBrush" Value="{DynamicResource DisabledBorderBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        A dropdown entry. The entry under the mouse or keyboard gets the Divider fill (it reads on the input
        background in both themes); the selected entry is semibold, so the two can be told apart while the list is open.
    -->
    <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="6,5,10,5" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border x:Name="Highlight"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="2"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Highlight" Property="Background" Value="{DynamicResource DividerBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        A narrow dropdown for a two-letter code (Part type). The closed box shows the code; the list grows past the
        box to fit "code: full name" entries (see the ComboBox style above), so no list width is set here.
    -->
    <Style x:Key="CodeComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Width" Value="68" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- Muted text beside a control, 8 after it (the full name beside the Part type dropdown). -->
    <Style x:Key="SideNoteText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource MutedText}">
        <Setter Property="Margin" Value="8,0,0,0" />
    </Style>

    <!--
        Focus outline for a checkbox: the same 2 px Accent outline as FocusOutline, drawn round the box only, not
        round the label. The box sits at the left, centred vertically (see the CheckBox template below).
    -->
    <Style x:Key="CheckBoxFocusOutline">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3"
                            Width="22"
                            Height="22"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            BorderThickness="2"
                            CornerRadius="5"
                            BorderBrush="{DynamicResource AccentBrush}"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Checkbox: a 16 px box (input fill and border) with a TextStrong check mark, then the label in TextPrimary,
        8 after the box. The box's corner radius is 3, a little under the 4 of full-size controls, so it still reads
        as square. A third state (IsChecked null) shows a short bar. Hover and press use the button veil on the box.
    -->
    <Style TargetType="{x:Type CheckBox}">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource CheckBoxFocusOutline}" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,0,0,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <!-- Transparent background so a click on the label toggles too. -->
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center">
                            <Border x:Name="Box"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3" />
                            <Border x:Name="Veil"
                                    Background="{DynamicResource TextPrimaryBrush}"
                                    CornerRadius="3"
                                    Opacity="0"
                                    IsHitTestVisible="False" />
                            <Path x:Name="CheckMark"
                                  Data="M 4,8 L 7,11 L 12,5"
                                  Stroke="{DynamicResource TextStrongBrush}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Visibility="Collapsed"
                                  SnapsToDevicePixels="False" />
                            <Rectangle x:Name="ThirdStateMark"
                                       Width="8"
                                       Height="2"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Fill="{DynamicResource TextStrongBrush}"
                                       Visibility="Collapsed" />
                        </Grid>
                        <ContentPresenter Grid.Column="1"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="ThirdStateMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Veil" Property="Opacity" Value="0.08" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Veil" Property="Opacity" Value="0.16" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Veil" Property="Opacity" Value="0" />
                            <Setter TargetName="CheckMark" Property="Stroke" Value="{DynamicResource DisabledTextBrush}" />
                            <Setter TargetName="ThirdStateMark" Property="Fill" Value="{DynamicResource DisabledTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="BorderBrush" Value="{DynamicResource DisabledBorderBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Lists (Mass Update, task 048) ===== -->

    <!--
        A list of entries that scrolls once it is taller than 320, so the window stays on screen. No sideways scroll:
        the entries wrap to the window's width. 9 below, as after a row. The shared scroll bar sits in a 20 column on
        the right that is always kept, so the entries keep a 12 gap from the bar and do not move when it appears.
    -->
    <Style x:Key="ListScroller" TargetType="{x:Type ScrollViewer}">
        <Setter Property="MaxHeight" Value="320" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="0,0,0,9" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollViewer}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                        </Grid.ColumnDefinitions>
                        <ScrollContentPresenter Grid.Column="0" CanContentScroll="{TemplateBinding CanContentScroll}" />
                        <ScrollBar x:Name="PART_VerticalScrollBar"
                                   Grid.Column="1"
                                   HorizontalAlignment="Right"
                                   Orientation="Vertical"
                                   Minimum="0"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Value="{TemplateBinding VerticalOffset}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- One entry in a list: 9 below it, as between form rows. -->
    <Style x:Key="ListItem" TargetType="{x:Type FrameworkElement}">
        <Setter Property="Margin" Value="0,0,0,9" />
    </Style>

    <!-- A checkbox in a line of checkboxes: 12 after it, the gap between a label and its value. -->
    <Style x:Key="InlineCheckBox" TargetType="{x:Type CheckBox}" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="Margin" Value="0,0,12,0" />
    </Style>

    <!-- An identifier beside a value, 8 before it (the Part Number beside a file name). -->
    <Style x:Key="SideIdentifierText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource IdentifierText}">
        <Setter Property="Margin" Value="8,0,0,0" />
    </Style>

    <!-- ===== Pick lists (Material and Finish, task 075) ===== -->

    <!--
        Keyboard focus on an entry in a pick list: the 2 px Accent outline drawn on the entry itself, not outside it,
        so the list's edge does not cut it off.
    -->
    <Style x:Key="PickListItemFocusOutline">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderThickness="2"
                            CornerRadius="2"
                            BorderBrush="{DynamicResource AccentBrush}"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        An entry in a pick list. The selected entry gets the Divider fill and is semibold, as in a dropdown; the entry
        under the mouse gets the thin TextPrimary veil of the buttons. The window's item template lays out the entry.
    -->
    <Style x:Key="PickListItem" TargetType="{x:Type ListBoxItem}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource PickListItemFocusOutline}" />
        <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="6,4,6,4" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid>
                        <Border x:Name="Highlight" Background="{TemplateBinding Background}" CornerRadius="2" />
                        <Border x:Name="Veil"
                                Background="{DynamicResource TextPrimaryBrush}"
                                CornerRadius="2"
                                Opacity="0"
                                IsHitTestVisible="False" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Veil" Property="Opacity" Value="0.06" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Highlight" Property="Background" Value="{DynamicResource DividerBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        A list to pick one entry from: the fill and border of a text box, 260 wide and 280 tall, so two fit side by side
        in the widest window and the window keeps its size while filters change the entries. It scrolls up and down;
        long entries are cut short by the window's item template, never scrolled sideways.
    -->
    <Style x:Key="PickList" TargetType="{x:Type ListBox}">
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="Width" Value="260" />
        <Setter Property="Height" Value="280" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <!-- 9 below, as after a row, so the section ends 18 before what follows. -->
        <Setter Property="Margin" Value="0,0,0,9" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource PickListItem}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBox}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                        <ScrollViewer Padding="{TemplateBinding Padding}"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="BorderBrush" Value="{DynamicResource DisabledBorderBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        The left of two columns side by side (the Materials and Finishes lists): 12 to the right column, the gap
        between a label and its value.
    -->
    <Style x:Key="LeftColumn" TargetType="{x:Type FrameworkElement}">
        <Setter Property="Margin" Value="0,0,12,0" />
    </Style>

    <!--
        The star before a material in a pick list: a glyph with no border or fill, muted, 6 before the name. Tag true
        (the material is preferred) draws it in TextStrong. Hover lays the button veil. The window sets the glyph.
    -->
    <Style x:Key="StarButton" TargetType="{x:Type Button}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusOutline}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="Padding" Value="2,0,2,0" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" CornerRadius="2" />
                        <Border x:Name="Veil"
                                Background="{DynamicResource TextPrimaryBrush}"
                                CornerRadius="2"
                                Opacity="0"
                                IsHitTestVisible="False" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Veil" Property="Opacity" Value="0.08" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Veil" Property="Opacity" Value="0.16" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Tag">
                <Trigger.Value>
                    <sys:Boolean>True</sys:Boolean>
                </Trigger.Value>
                <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Shared pieces (UI/Controls) ===== -->

    <!-- Header band: icon tile, title, subline; 18 above the first section. -->
    <Style TargetType="{x:Type controls:DialogHeader}">
        <Setter Property="Margin" Value="0,0,0,18" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:DialogHeader}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Width="36"
                                Height="36"
                                CornerRadius="6"
                                VerticalAlignment="Center"
                                Background="{DynamicResource IconTileBrush}">
                            <Image Margin="2"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Source="{TemplateBinding Icon}" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Style="{DynamicResource HeaderTitleText}" Text="{TemplateBinding Title}" />
                            <TextBlock x:Name="SublineText"
                                       Style="{DynamicResource HeaderSublineText}"
                                       Text="{TemplateBinding Subline}" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Subline" Value="{x:Null}">
                            <Setter TargetName="SublineText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Subline" Value="">
                            <Setter TargetName="SublineText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Section: heading, 1 px divider, 9 to the first row. Each row ends with its own 9; the section adds 9 more,
        so the gap to the next section or to the footer is 18. With no heading, the heading and divider are not drawn.
    -->
    <Style TargetType="{x:Type controls:FormSection}">
        <Setter Property="Margin" Value="0,0,0,9" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:FormSection}">
                    <StackPanel>
                        <StackPanel x:Name="HeadingPanel" Margin="0,0,0,9">
                            <TextBlock Style="{DynamicResource SectionHeadingText}"
                                       Text="{TemplateBinding DisplayHeading}"
                                       AutomationProperties.Name="{TemplateBinding Heading}" />
                            <Border Height="1" Margin="0,4,0,0" Background="{DynamicResource DividerBrush}" />
                        </StackPanel>
                        <ItemsPresenter />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasHeading" Value="False">
                            <Setter TargetName="HeadingPanel" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Collapsible section (task 079): laid out as a FormSection with a heading, but the heading is a button. A chevron
        before the heading points down while expanded and right while collapsed; while collapsed the rows are hidden
        and the summary shows on the heading's line in muted text, cut short with an ellipsis (its tooltip has it all).
        The whole heading line is the button: click it, or press Space when it has focus.
    -->
    <Style x:Key="SectionSummaryText" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="Margin" Value="12,0,0,0" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style TargetType="{x:Type controls:CollapsibleSection}">
        <Setter Property="Margin" Value="0,0,0,9" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:CollapsibleSection}">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,9">
                            <ToggleButton FocusVisualStyle="{DynamicResource FocusOutline}"
                                          HorizontalContentAlignment="Stretch"
                                          Cursor="Hand"
                                          AutomationProperties.Name="{TemplateBinding Heading}"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border Background="Transparent">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <DockPanel>
                                    <Path x:Name="Chevron"
                                          DockPanel.Dock="Left"
                                          Width="8"
                                          Height="8"
                                          Margin="0,0,8,0"
                                          VerticalAlignment="Center"
                                          Data="M 0,2 L 4,6 L 8,2"
                                          Stroke="{DynamicResource SectionHeadingBrush}"
                                          StrokeThickness="1.5"
                                          RenderTransformOrigin="0.5,0.5"
                                          SnapsToDevicePixels="False">
                                        <Path.RenderTransform>
                                            <RotateTransform Angle="0" />
                                        </Path.RenderTransform>
                                    </Path>
                                    <TextBlock DockPanel.Dock="Left"
                                               Style="{DynamicResource SectionHeadingText}"
                                               VerticalAlignment="Center"
                                               Text="{TemplateBinding DisplayHeading}" />
                                    <TextBlock x:Name="SummaryText"
                                               Style="{DynamicResource SectionSummaryText}"
                                               Text="{TemplateBinding Summary}"
                                               ToolTip="{TemplateBinding Summary}"
                                               Visibility="Collapsed" />
                                </DockPanel>
                            </ToggleButton>
                            <Border Height="1" Margin="0,4,0,0" Background="{DynamicResource DividerBrush}" />
                        </StackPanel>
                        <ItemsPresenter x:Name="Rows" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="Rows" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="SummaryText" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="-90" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        A square of a colour that is data (a dowel hole's fit colour, AWB Hole, task 090): 14 square, radius 3, an input
        border round it so a light colour still shows on the light theme, 8 before the text beside it. The control sets
        the fill from the data; nothing here does.
    -->
    <Style TargetType="{x:Type controls:ColourSwatch}">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Row: label column 100 wide, 12 to the value, 9 below each row. -->
    <Style TargetType="{x:Type controls:FieldRow}">
        <Setter Property="Margin" Value="0,0,0,9" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:FieldRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0"
                               Style="{DynamicResource LabelText}"
                               Content="{TemplateBinding Label}"
                               Target="{TemplateBinding Target}" />
                        <ContentPresenter Grid.Column="1"
                                          Margin="12,0,0,0"
                                          VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Footer: status line on the left (muted, or the error style when IsError; not drawn when empty),
        buttons on the right, 8 apart, in one row. The 8 is on the left of every button, which also keeps
        the status line clear of the first button.
    -->
    <Style TargetType="{x:Type controls:DialogFooter}">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="{x:Type ContentPresenter}">
                    <Setter Property="Margin" Value="8,0,0,0" />
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:DialogFooter}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusLine"
                                   Grid.Column="0"
                                   Style="{DynamicResource StatusText}"
                                   Text="{TemplateBinding Status}"
                                   ToolTip="{TemplateBinding StatusToolTip}" />
                        <TextBlock x:Name="ErrorLine"
                                   Grid.Column="0"
                                   Visibility="Collapsed"
                                   Style="{DynamicResource ErrorStatusText}"
                                   Text="{TemplateBinding Status}"
                                   ToolTip="{TemplateBinding StatusToolTip}" />
                        <ItemsPresenter Grid.Column="1" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Later triggers win: an empty status hides both lines. -->
                        <Trigger Property="IsError" Value="True">
                            <Setter TargetName="StatusLine" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ErrorLine" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Status" Value="{x:Null}">
                            <Setter TargetName="StatusLine" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ErrorLine" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Status" Value="">
                            <Setter TargetName="StatusLine" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ErrorLine" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
