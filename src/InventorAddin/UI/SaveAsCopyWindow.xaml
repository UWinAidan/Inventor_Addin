<Window x:Class="InventorAddin.UI.SaveAsCopyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:InventorAddin.UI.Controls"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <!--
        DataContext is a SaveAsCopyViewModel (InventorAddin.Core.ViewModels), set in the constructor.
        Layout and bindings only: the look comes from UI/Theme, applied by WindowHost after the window is built,
        so shared styles are referred to with DynamicResource. SizeToContent and ResizeMode are repeated from the
        DialogWindow style so the window still sizes to its content if the shared styles fail to load.

        Spec 02, "Commands: Save As Copy": the copy's part name and part type, pre-filled from the original, with the
        same file name preview and validation as New Part. The folder is the original's and cannot be changed. The
        header subline is the original's file name. For an assembly a note says its components are shared, not copied.
        Designer and Detailer are not asked; they come from Settings.

        Save As and Replace (task 046) shows this same window through SaveAsCopyViewModel.ForReplace: the header and the
        Save button say Save As and Replace, and for a component inside a sub-assembly a warning above the buttons says
        the sub-assembly (named) will change and be saved, and Undo cannot put it back.

        Access keys: N part name, T part type, S save.
    -->
    <Window.Resources>
        <!-- Collapses the assembly note for a part, and the sub-assembly warning when there is none. -->
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
    </Window.Resources>

    <Grid Style="{DynamicResource DialogContent}">
        <!-- Header, body, footer. The body row is star-sized, so it scrolls when the window is capped at the screen's height. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The header icon is put in the window's resources by WindowHost (HeaderIcon), in the window's theme. -->
        <controls:DialogHeader Grid.Row="0"
                               Icon="{DynamicResource HeaderIcon}"
                               Title="{Binding HeaderTitle, Mode=OneTime}"
                               Subline="{Binding HeaderSubline, Mode=OneTime}" />

        <ScrollViewer Grid.Row="1" Style="{DynamicResource DialogBody}">
            <StackPanel Style="{DynamicResource DialogBodyContent}">
                <controls:FormSection Heading="Identity">
                    <controls:FieldRow Label="Part _name" Target="{Binding ElementName=PartNameBox}">
                        <TextBox x:Name="PartNameBox"
                                 CharacterCasing="Upper"
                                 Text="{Binding PartName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </controls:FieldRow>
                    <controls:FieldRow Label="Part _type" Target="{Binding ElementName=PartTypeBox}">
                        <StackPanel Orientation="Horizontal">
                            <!--
                                As in Part Properties and New Part: not editable; the closed box shows the code and each
                                dropdown entry shows "code: full name". The template tells the two apart by whether it sits
                                inside a ComboBoxItem (only dropdown entries do). The full name of the chosen code is beside it.
                            -->
                            <ComboBox x:Name="PartTypeBox"
                                      Style="{DynamicResource CodeComboBox}"
                                      IsEditable="False"
                                      ItemsSource="{Binding PartTypeOptions, Mode=OneTime}"
                                      SelectedValuePath="Code"
                                      SelectedValue="{Binding PartType, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="OptionText" Text="{Binding DisplayText, Mode=OneWay}" />
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" Value="{x:Null}">
                                                <Setter TargetName="OptionText" Property="Text" Value="{Binding Code, Mode=OneWay}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Style="{DynamicResource SideNoteText}" Text="{Binding PartTypeFullName, Mode=OneWay}" />
                        </StackPanel>
                    </controls:FieldRow>
                </controls:FormSection>

                <controls:FormSection Heading="Location">
                    <!-- The original's folder; the copy always goes there. Selectable so it can be copied, not edited. -->
                    <controls:FieldRow Label="Folder">
                        <TextBox Style="{DynamicResource SelectableText}" Text="{Binding Folder, Mode=OneTime}" />
                    </controls:FieldRow>
                    <!-- The file name, name first and AWB-????? for the number (NAME,AWB-?????.ipt); empty while the part name is not valid. -->
                    <controls:FieldRow Label="File name">
                        <TextBlock Style="{DynamicResource IdentifierText}" Text="{Binding FileNamePreview, Mode=OneWay}" />
                    </controls:FieldRow>
                    <!-- Assemblies only: the copy shares its components with the original. -->
                    <TextBlock Style="{DynamicResource MutedText}"
                               Text="{Binding Note, Mode=OneTime}"
                               Visibility="{Binding HasNote, Mode=OneTime, Converter={StaticResource VisibleWhenTrue}}" />
                    <!-- Save As and Replace inside a sub-assembly only: the sub-assembly is changed and saved, and Undo cannot put it back. -->
                    <TextBlock Style="{DynamicResource ErrorStatusText}"
                               Text="{Binding Warning, Mode=OneTime}"
                               Visibility="{Binding HasWarning, Mode=OneTime, Converter={StaticResource VisibleWhenTrue}}" />
                </controls:FormSection>
            </StackPanel>
        </ScrollViewer>

        <!-- The first problem with the name, or nothing (the status line is then not drawn). Save stays disabled meanwhile. -->
        <controls:DialogFooter Grid.Row="2" Status="{Binding ValidationMessage, Mode=OneWay}" IsError="True">
            <Button Style="{DynamicResource PrimaryButton}" Content="{Binding SaveButtonText, Mode=OneTime}" IsDefault="True" Command="{Binding SaveCommand}" />
            <!-- IsCancel closes a dialog shown with ShowDialog; nothing is copied. -->
            <Button Content="Cancel" IsCancel="True" />
        </controls:DialogFooter>
    </Grid>
</Window>
