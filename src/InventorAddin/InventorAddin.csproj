<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Inventor add-in. Inventor 2025+ loads add-ins on .NET 8.
    Building requires Inventor installed (for Autodesk.Inventor.Interop.dll).
    Override the install location with: dotnet build -p:InventorInstallDir="D:\Autodesk\Inventor 2026"
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>InventorAddin</RootNamespace>
    <AssemblyName>InventorAddin</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

    <!-- Shown in the About window. The SDK may append "+<commit>" to the informational version. -->
    <Version>0.1.0</Version>

    <InventorVersion>2026</InventorVersion>
    <InventorInstallDir Condition="'$(InventorInstallDir)' == ''">C:\Program Files\Autodesk\Inventor $(InventorVersion)</InventorInstallDir>
    <InventorAddinsDir>$(APPDATA)\Autodesk\Inventor $(InventorVersion)\Addins</InventorAddinsDir>
    <!-- Copy the build into Inventor's per-user add-in folder after each build. Disable with -p:DeployToInventor=false -->
    <DeployToInventor Condition="'$(DeployToInventor)' == ''">true</DeployToInventor>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Autodesk.Inventor.Interop">
      <HintPath>$(InventorInstallDir)\Bin\Public Assemblies\Autodesk.Inventor.Interop.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
    <!--
      ButtonDefinition.StandardIcon and LargeIcon are typed stdole.IPictureDisp (spike 020); without this
      reference the build fails with CS0012. Inventor ships stdole.dll and loads it, so it is not copied.
    -->
    <Reference Include="stdole">
      <HintPath>$(InventorInstallDir)\Bin\stdole.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
    Ribbon and header icons (task 024), found by IconLoader as "InventorAddin.UI.Icons.{Name}.{Light|Dark}.{16|32}.png".
    Only the PNGs are embedded; the .svg sources in the same folder stay out of the build.
  -->
  <ItemGroup>
    <None Remove="UI\Icons\*.png" />
    <EmbeddedResource Include="UI\Icons\*.png" LogicalName="InventorAddin.UI.Icons.%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    UTC build time in ISO 8601, read by the About window through AssemblyMetadataAttribute("BuildDate").
    The value changes on every build, so the add-in assembly always recompiles.
    The colons are escaped because an unescaped ':' is the culture's time separator ('.' in some locales).
  -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BuildDate</_Parameter1>
      <_Parameter2>$([System.DateTime]::UtcNow.ToString("yyyy-MM-ddTHH\:mm\:ssZ"))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InventorAddin.Core\InventorAddin.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="InventorAddin.addin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Deploy layout:
      %APPDATA%\Autodesk\Inventor 2026\Addins\InventorAddin.addin
      %APPDATA%\Autodesk\Inventor 2026\Addins\InventorAddin\*.dll
    Close Inventor before building or the DLL will be locked. A locked file does not fail the build:
    each Copy turns its error into a warning, its result is captured from MSBuildLastTaskResult,
    and the target ends with exactly one line: "Deployed add-in to ..." (message) or "NOT deployed: ..." (warning).
    The first Copy uses DestinationFiles with a transform rather than DestinationFolder with %(RecursiveDir),
    so it runs once instead of once per subfolder and its result covers every file.
  -->
  <Target Name="DeployToInventor" AfterTargets="Build" Condition="'$(DeployToInventor)' == 'true' And '$(OS)' == 'Windows_NT'">
    <ItemGroup>
      <_DeployFiles Include="$(OutDir)**\*.*" Exclude="$(OutDir)InventorAddin.addin" />
    </ItemGroup>
    <Copy SourceFiles="@(_DeployFiles)" DestinationFiles="@(_DeployFiles->'$(InventorAddinsDir)\InventorAddin\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" ContinueOnError="WarnAndContinue" />
    <PropertyGroup>
      <_DeployFilesCopied>$(MSBuildLastTaskResult)</_DeployFilesCopied>
    </PropertyGroup>
    <Copy SourceFiles="$(OutDir)InventorAddin.addin" DestinationFolder="$(InventorAddinsDir)" SkipUnchangedFiles="true" ContinueOnError="WarnAndContinue" />
    <PropertyGroup>
      <_DeployManifestCopied>$(MSBuildLastTaskResult)</_DeployManifestCopied>
    </PropertyGroup>
    <Message Importance="high" Condition="'$(_DeployFilesCopied)' == 'true' And '$(_DeployManifestCopied)' == 'true'" Text="Deployed add-in to $(InventorAddinsDir). Start Inventor to load this build." />
    <Warning Condition="'$(_DeployFilesCopied)' != 'true' Or '$(_DeployManifestCopied)' != 'true'" Text="NOT deployed: the add-in files in $(InventorAddinsDir) are locked, probably because Inventor is running. Close Inventor and build again." />
  </Target>

</Project>
