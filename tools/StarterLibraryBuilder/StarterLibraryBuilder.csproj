<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Generates libraries/StarterMaterials.adsklib from libraries/starter-materials.csv (task 071) by driving its own
    invisible Inventor over COM. A developer tool: not part of InventorAddin.slnx. Needs Inventor installed.
    Override the install location with: dotnet run -p:InventorInstallDir="D:\Autodesk\Inventor 2026"
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>StarterLibraryBuilder</RootNamespace>
    <InventorVersion>2026</InventorVersion>
    <InventorInstallDir Condition="'$(InventorInstallDir)' == ''">C:\Program Files\Autodesk\Inventor $(InventorVersion)</InventorInstallDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Copied beside the exe (unlike the add-in, which runs inside Inventor and gets the interop from there). -->
    <Reference Include="Autodesk.Inventor.Interop">
      <HintPath>$(InventorInstallDir)\Bin\Public Assemblies\Autodesk.Inventor.Interop.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>true</Private>
    </Reference>
    <Reference Include="stdole">
      <HintPath>$(InventorInstallDir)\Bin\stdole.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\InventorAddin.Core\InventorAddin.Core.csproj" />
  </ItemGroup>

</Project>
